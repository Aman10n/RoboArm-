# Comma-separated origins allowed by the FastAPI service.
ROBOARM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional backend deployment paths.
ROBOARM_DB_PATH=data/roboarm.db
ROBOARM_STATIC_DIR=

# Persist one telemetry sample for every N simulator telemetry frames.
ROBOARM_TELEMETRY_LOG_INTERVAL=8

# Optional frontend overrides for a separately deployed API.
VITE_API_URL=
VITE_WS_URL=
